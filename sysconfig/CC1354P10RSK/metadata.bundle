{"/CC1354P10RSK/templates/csv/summary.csv.xdt":"% var $legacy = pmux.getScript(\"/legacy/adapt.js\")(pmux), assignmentErrors = $legacy.assignmentErrors, assignments = $legacy.assignments, peripheralConfigurables = $legacy.peripheralConfigurables, peripheralConfigurations = $legacy.peripheralConfigurations, selectedUseCases = $legacy.selectedUseCases, version = $legacy.version, deviceData = $legacy.deviceData;\n%%{\n\tvar gpioType = function( assignment ) {\n\t\tif( assignment.input ) {\n\t\t\treturn \"Input\";\n\t\t} else if( assignment.output ) {\n\t\t\treturn \"Output\";\n\t\t} else if( assignment.outputOpenDrain ) {\n\t\t\treturn \"Output OD\";\n\t\t} else {\n\t\t\treturn \"\";\n\t\t}\n\t};\n%%}\nPin#, PORT IO, Function, Direction\n% for( var i = 0; i < assignments.length; ++i ) {\n`assignments[i].devicePin.ball`,`assignments[i].devicePin.designSignalName`,`assignments[i].peripheralPin.name`,`gpioType( assignments[i] )`\n% }\n"}