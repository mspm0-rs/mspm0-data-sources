                                    <enumeratedValue>
                                        <name>ENABLE</name>
                                        <description>An interrupt is sent to the interrupt controller when the RESUME bit in the USBIS register is set.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>RESETBABBLE</name>
                            <description>Interrupt enable for RESET/BABBLE signaling detected.</description>
                            <bitOffset>0x2</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DSIABLE</name>
                                        <description>The RESET interrupt is suppressed and not sent to the interrupt controller.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ENABLE</name>
                                        <description>An interrupt is sent to the interrupt controller when the RESET bit in the USBIS register is set.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>SOF</name>
                            <description>Interrupt enable for Start of frame.</description>
