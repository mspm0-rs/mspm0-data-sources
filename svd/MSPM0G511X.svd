                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>INT</name>
                                        <description>A new frame has started.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>CONN</name>
                            <description>Set when a device connection is detected. 
Note: Only valid in Host mode. Valid at all transaction speeds.</description>
                            <bitOffset>0x4</bitOffset>
                            <bitWidth>0x1</bitWidth>
