                        <field>
                            <name>WTCON</name>
                            <description>The connect wait field configures the wait required to allow for the user's connect/disconnect filter, in units of 533.3 ns.
Note: The default corresponds to 2.667 us.</description>
                            <bitOffset>0x4</bitOffset>
                            <bitWidth>0x4</bitWidth>
                            <access>read-write</access>
                            </field>
