                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SIZE_25</name>
                                        <description>25% of the total timer period is closed window</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SIZE_50</name>
                                        <description>50% of the total timer period is closed window</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SIZE_75</name>
                                        <description>75% of the total timer period is closed window</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SIZE_81</name>
                                        <description>81.25% of the total timer period is closed window</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SIZE_87</name>
                                        <description>87.50% of the total timer period is closed window</description>
                                        <value>0x7</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                    </fields>
                </register>
                <register>
