                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>RANGE16TO20</name>
                                        <description>&gt;16 to 20 MHz</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>RANGE20TO24</name>
                                        <description>&gt;20 to 24 MHz</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>RANGE24TO32</name>
                                        <description>&gt;24 to 32 MHz</description>
                                        <value>0x5</value>
