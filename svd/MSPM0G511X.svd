                                    </enumeratedValues>
                                </field>
                            <field>
                                <name>NUMDIAG</name>
                                <description>This is a hardware constant that indicates how many DIAGPAR registers are included in this SFTYDIAG sub-region.</description>
                                <bitOffset>0x10</bitOffset>
                                <bitWidth>0xA</bitWidth>
                                </field>
                        </fields>
