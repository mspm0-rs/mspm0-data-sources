                        <field>
                            <name>WTID</name>
                            <description>The wait ID field configures the delay required from the enable of the ID detection to when the ID value is valid, in units of 4.369 ms.
Note: The default corresponds to 52.43 ms.</description>
                            <bitOffset>0x0</bitOffset>
