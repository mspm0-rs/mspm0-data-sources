                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>CLK0DIV2</name>
                                        <description>SYSPLLCLK0 is divided by 2</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV4</name>
                                        <description>SYSPLLCLK0 is divided by 4</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV6</name>
                                        <description>SYSPLLCLK0 is divided by 6</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV8</name>
                                        <description>SYSPLLCLK0 is divided by 8</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV10</name>
                                        <description>SYSPLLCLK0 is divided by 10</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV12</name>
                                        <description>SYSPLLCLK0 is divided by 12</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV14</name>
                                        <description>SYSPLLCLK0 is divided by 14</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV16</name>
                                        <description>SYSPLLCLK0 is divided by 16</description>
                                        <value>0x7</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV18</name>
                                        <description>SYSPLLCLK0 is divided by 18</description>
                                        <value>0x8</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV20</name>
                                        <description>SYSPLLCLK0 is divided by 20</description>
                                        <value>0x9</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV22</name>
                                        <description>SYSPLLCLK0 is divided by 22</description>
                                        <value>0xA</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV24</name>
                                        <description>SYSPLLCLK0 is divided by 24</description>
                                        <value>0xB</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV26</name>
                                        <description>SYSPLLCLK0 is divided by 26</description>
                                        <value>0xC</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV28</name>
                                        <description>SYSPLLCLK0 is divided by 28</description>
                                        <value>0xD</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV30</name>
                                        <description>SYSPLLCLK0 is divided by 30</description>
                                        <value>0xE</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CLK0DIV32</name>
                                        <description>SYSPLLCLK0 is divided by 32</description>
                                        <value>0xF</value>
                                    </enumeratedValue>
