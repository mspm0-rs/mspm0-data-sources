                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>SOFTWARE</name>
                                        <description>Software trigger</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EVENT</name>
                                        <description>Hardware event trigger</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>SC</name>
                            <description>Start of conversion</description>
                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>STOP</name>
                                        <description>When SAMPMODE is set to MANUAL, clearing this bit will end the sample phase and the conversion phase will start. When SAMPMODE is set to AUTO, writing 0 has no effect.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>START</name>
                                        <description>When SAMPMODE is set to MANUAL, setting this bit will start the sample phase. Sample phase will last as long as this bit is set.  When SAMPMODE is set to AUTO, setting this bit will trigger the timer based sample time.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>CONSEQ</name>
                            <description>Conversion sequence mode</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>SINGLE</name>
                                        <description>ADC channel in MEMCTLx pointed by STARTADD will be converted once</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SEQUENCE</name>
                                        <description>ADC channel sequence pointed by STARTADD and ENDADD will be converted once</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>REPEATSINGLE</name>
                                        <description>ADC channel in MEMCTLx pointed by STARTADD will be converted repeatedly</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>REPEATSEQUENCE</name>
                                        <description>ADC channel sequence pointed by STARTADD and ENDADD will be converted repeatedly</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>SAMPMODE</name>
                            <description>Sample mode. This bit selects the source of the sampling signal. 
MANUAL option is not valid when TRIGSRC is selected as hardware event trigger.</description>
                            <bitOffset>0x14</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>AUTO</name>
                                        <description>Sample timer high phase is used as sample signal</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>MANUAL</name>
                                        <description>Software trigger is used as sample signal</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>AVGN</name>
                            <description>Hardware averager numerator. Selects number of conversions to accumulate for current MEMCTLx and then it is divided by AVGD. Result will be stored in MEMRESx.</description>
                            <bitOffset>0x18</bitOffset>
                            <bitWidth>0x3</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DISABLE</name>
                                        <description>Disables averager</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>AVG_2</name>
                                        <description>Averages 2 conversions before storing in MEMRESx register</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>AVG_4</name>
                                        <description>Averages 4 conversions before storing in MEMRESx register</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>AVG_8</name>
                                        <description>Averages 8 conversions before storing in MEMRESx register</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>AVG_16</name>
                                        <description>Averages 16 conversions before storing in MEMRESx register</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>AVG_32</name>
                                        <description>Averages 32 conversions before storing in MEMRESx register</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>AVG_64</name>
                                        <description>Averages 64 conversions before storing in MEMRESx register</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>AVG_128</name>
                                        <description>Averages 128 conversions before storing in MEMRESx register</description>
                                        <value>0x7</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>AVGD</name>
                            <description>Hardware averager denominator. The number to divide the accumulated value by (this is a shift). Note result register is maximum of 16-bits long so if not shifted appropriately result will be truncated.</description>
                            <bitOffset>0x1C</bitOffset>
                            <bitWidth>0x3</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>SHIFT0</name>
                                        <description>No shift</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT1</name>
                                        <description>1 bit shift</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT2</name>
                                        <description>2 bit shift</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT3</name>
                                        <description>3 bit shift</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT4</name>
                                        <description>4 bit shift</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT5</name>
                                        <description>5 bit shift</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT6</name>
                                        <description>6 bit shift</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SHIFT7</name>
                                        <description>7 bit shift</description>
                                        <value>0x7</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                    </fields>
                </register>
                <register>
                    <name>ADC0_CTL2</name>
                    <description>Control Register 2</description>
                    <addressOffset>0x1108</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>DF</name>
                            <description>Data read-back format. Data is always stored in binary unsigned format.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>UNSIGNED</name>
                                        <description>Digital result reads as Binary Unsigned.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>SIGNED</name>
                                        <description>Digital result reads Signed Binary. (2s complement), left aligned.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>RES</name>
                            <description>Resolution. These bits define the resolution of ADC conversion result.
Note : A value of 3 defaults to 12-bits resolution.</description>
                            <bitOffset>0x1</bitOffset>
                            <bitWidth>0x2</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>BIT_12</name>
                                        <description>12-bits resolution</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>BIT_10</name>
                                        <description>10-bits resolution</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>BIT_8</name>
                                        <description>8-bits resolution</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>STARTADD</name>
                            <description>Sequencer start address. These bits select which MEMCTLx is used for single conversion or as first MEMCTL for sequence mode. 
The value of STARTADD is 0x00 to 0x17, corresponding to MEMRES0 to MEMRES23.</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x5</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>ADDR_00</name>
                                        <description>MEMCTL0 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_01</name>
                                        <description>MEMCTL1 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_02</name>
                                        <description>MEMCTL2 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_03</name>
                                        <description>MEMCTL3 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_04</name>
                                        <description>MEMCTL4 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_05</name>
                                        <description>MEMCTL5 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_06</name>
                                        <description>MEMCTL6 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_07</name>
                                        <description>MEMCTL7 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x7</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_08</name>
                                        <description>MEMCTL8 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x8</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_09</name>
                                        <description>MEMCTL9 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x9</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_10</name>
                                        <description>MEMCTL10 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0xA</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_11</name>
                                        <description>MEMCTL11 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0xB</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_12</name>
                                        <description>MEMCTL12 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0xC</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_13</name>
                                        <description>MEMCTL13 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0xD</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_14</name>
                                        <description>MEMCTL14 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0xE</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_15</name>
                                        <description>MEMCTL15 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0xF</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_16</name>
                                        <description>MEMCTL16 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x10</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_17</name>
                                        <description>MEMCTL17 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x11</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_18</name>
                                        <description>MEMCTL18 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x12</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_19</name>
                                        <description>MEMCTL19 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x13</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_20</name>
                                        <description>MEMCTL20 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x14</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_21</name>
                                        <description>MEMCTL21 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x15</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_22</name>
                                        <description>MEMCTL22 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x16</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_23</name>
                                        <description>MEMCTL23 is selected as start address of a sequence or for a single conversion.</description>
                                        <value>0x17</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>ENDADD</name>
                            <description>Sequence end address. These bits select which MEMCTLx is the last one for the sequence mode.
The value of ENDADD is 0x00 to 0x17, corresponding to MEMRES0 to MEMRES23.</description>
                            <bitOffset>0x18</bitOffset>
                            <bitWidth>0x5</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>ADDR_00</name>
                                        <description>MEMCTL0 is selected as end address of sequence.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_01</name>
                                        <description>MEMCTL1 is selected as end address of sequence.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_02</name>
                                        <description>MEMCTL2 is selected as end address of sequence.</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_03</name>
                                        <description>MEMCTL3 is selected as end address of sequence.</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_04</name>
                                        <description>MEMCTL4 is selected as end address of sequence.</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_05</name>
                                        <description>MEMCTL5 is selected as end address of sequence.</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_06</name>
                                        <description>MEMCTL6 is selected as end address of sequence.</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_07</name>
                                        <description>MEMCTL7 is selected as end address of sequence.</description>
                                        <value>0x7</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_08</name>
                                        <description>MEMCTL8 is selected as end address of sequence.</description>
                                        <value>0x8</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_09</name>
                                        <description>MEMCTL9 is selected as end address of sequence.</description>
                                        <value>0x9</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_10</name>
                                        <description>MEMCTL10 is selected as end address of sequence.</description>
                                        <value>0xA</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_11</name>
                                        <description>MEMCTL11 is selected as end address of sequence.</description>
                                        <value>0xB</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_12</name>
                                        <description>MEMCTL12 is selected as end address of sequence.</description>
                                        <value>0xC</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_13</name>
                                        <description>MEMCTL13 is selected as end address of sequence.</description>
                                        <value>0xD</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_14</name>
                                        <description>MEMCTL14 is selected as end address of sequence.</description>
                                        <value>0xE</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_15</name>
                                        <description>MEMCTL15 is selected as end address of sequence.</description>
                                        <value>0xF</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_16</name>
                                        <description>MEMCTL16 is selected as end address of sequence.</description>
                                        <value>0x10</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_17</name>
                                        <description>MEMCTL17 is selected as end address of sequence.</description>
                                        <value>0x11</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_18</name>
                                        <description>MEMCTL18 is selected as end address of sequence.</description>
                                        <value>0x12</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_19</name>
                                        <description>MEMCTL19 is selected as end address of sequence.</description>
                                        <value>0x13</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ADDR_20</name>
                                        <description>MEMCTL20 is selected as end address of sequence.</description>
                                        <value>0x14</value>
