                                        <description>Total timer count is 2^25</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EN_21</name>
                                        <description>Total timer count is 2^21</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EN_18</name>
                                        <description>Total timer count is 2^18</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EN_15</name>
                                        <description>Total timer count is 2^15</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EN_12</name>
                                        <description>Total timer count is 2^12 (default)</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EN_10</name>
                                        <description>Total timer count is 2^10</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EN_8</name>
                                        <description>Total timer count is 2^8</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EN_6</name>
                                        <description>Total timer count is 2^6</description>
