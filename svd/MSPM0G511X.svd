                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>INT</name>
                                        <description>The device has detected a connection to the host.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>DISCON</name>
                            <description>Set in Host mode when a device disconnect is detected.
Set in Peripheral mode when a session ends. Valid at all transaction speeds.</description>
                            <bitOffset>0x5</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-only</access>
                            <enumeratedValues>
