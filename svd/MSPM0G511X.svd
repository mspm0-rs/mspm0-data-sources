                        <field>
                            <name>VAL0</name>
                            <description>ECC data for bits 63:0 of the data is placed here.</description>
                            <bitOffset>0x0</bitOffset>
                            <bitWidth>0x8</bitWidth>
                            <access>read-write</access>
                            </field>
                        <field>
                            <name>VAL1</name>
                            <description>ECC data for bits 127:64 of the data is placed here.</description>
