                            <bitOffset>0x8</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <access>read-write</access>
                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>USBSOF</name>
                                        <description>Use USB Start-Of-Frame as Reference Clock</description>
