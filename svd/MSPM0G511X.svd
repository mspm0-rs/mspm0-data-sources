                            <enumeratedValues>
                                    <enumeratedValue>
                                        <name>FALSE</name>
                                        <description>USB CLK is not ready</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>TRUE</name>
                                        <description>USB CLK is ready</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        <field>
                            <name>FRQADJ</name>
                            <description>Current Frequency Lock Loop Adjust</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x6</bitWidth>
